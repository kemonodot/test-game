extends SceneTree
const Profile=preload("res://src/profile.gd")
const PATH_TEST="user://salvage_test_save.json"
func _initialize()->void:call_deferred("run")
func run()->void:
 DirAccess.remove_absolute(ProjectSettings.globalize_path(PATH_TEST))
 var p=Profile.new(false,PATH_TEST)
 var starter:int=p.data.equipped.fang
 for i in 600:
  var item:Dictionary=p.create_item("bite",i%5)
  if i==0 or i==1:item.sockets.append({"family":"devour","tier":1})
  p.data.inventory.append(item)
 var held:Dictionary=p.create_item("mouth",2);p.data.inventory.append(held);assert(p.equip(held.uid,"organ1"))
 var legendary:Dictionary=p.data.inventory.filter(func(x):return int(x.rarity)==3)[0]
 var mythic:Dictionary=p.data.inventory.filter(func(x):return int(x.rarity)==4)[0]
 var rare_preview:Dictionary=p.salvage_preview(1)
 var epic_preview:Dictionary=p.salvage_preview(2)
 assert(rare_preview.count==240 and rare_preview.gold==1560)
 assert(epic_preview.count==360 and epic_preview.gold==5160)
 assert(p.salvage_item(starter).count==0 and p.salvage_item(held.uid).count==0)
 var start:=Time.get_ticks_usec()
 assert(p.save_game())
 var bulk:Dictionary=p.salvage_bulk(1)
 assert(bulk==rare_preview and p.data.inventory.size()==362 and p.data.gold==1560)
 assert(p.data.gems["devour:1"]==2 and not p.get_item(held.uid).is_empty())
 bulk=p.salvage_bulk(99)
 assert(bulk.count==120 and bulk.gold==3600 and not p.get_item(legendary.uid).is_empty() and not p.get_item(mythic.uid).is_empty())
 assert(p.salvage_item(legendary.uid).gold==100)
 assert(p.salvage_item(mythic.uid).gold==250)
 assert(p.data.gold==5510 and p.data.inventory.size()==240)
 assert(p.save_game())
 var reopened=Profile.new(true,PATH_TEST)
 assert(not reopened.load_failed and reopened.data.inventory.size()==240 and reopened.data.gold==5510)
 assert(reopened.data.gems["devour:1"]==2 and int(reopened.data.equipped.organ1)==int(held.uid))
 var elapsed_ms:float=float(Time.get_ticks_usec()-start)/1000.0
 # Invalid or incomplete input must never be replaced by a new starter save.
 var bad_path:="user://salvage_bad_save.json"
 var bad:=FileAccess.open(bad_path,FileAccess.WRITE);bad.store_string("{broken json");bad.close()
 var broken=Profile.new(true,bad_path)
 assert(broken.load_failed and not broken.save_game())
 assert(FileAccess.get_file_as_string(bad_path)=="{broken json")
 var bad_schema:=FileAccess.open(bad_path,FileAccess.WRITE);bad_schema.store_string('{"version":1,"inventory":[]}');bad_schema.close()
 assert(not broken.load_game() and broken.load_failed)
 var restored:=FileAccess.open(bad_path,FileAccess.WRITE);restored.store_string(JSON.stringify(reopened.data));restored.close()
 assert(broken.load_game() and not broken.load_failed and broken.data.gold==5510)
 # Both an unwritable path and a failed atomic rename report failure.
 var missing=Profile.new(false,"user://nonexistent_directory/save.json")
 assert(not missing.save_game() and not missing.io_error.is_empty())
 var directory_path:="user://salvage_rename_directory"
 DirAccess.make_dir_absolute(ProjectSettings.globalize_path(directory_path))
 var rename_failure=Profile.new(false,directory_path)
 assert(not rename_failure.save_game() and DirAccess.dir_exists_absolute(ProjectSettings.globalize_path(directory_path)))
 # Verify the actual inventory screen, confirmation, and independent warning layer.
 var app=load("res://main.tscn").instantiate();root.add_child(app)
 app.profile=Profile.new(false,"user://nonexistent_directory/save.json")
 var target:Dictionary=app.profile.create_item("bite",1);app.profile.data.inventory.append(target)
 app.show_inventory();app.selected_uid=target.uid;app.show_inventory()
 app.confirm_salvage(1)
 var modal:Node=app.ui.get_node_or_null("SalvageConfirmation")
 assert(modal!=null and str(modal.find_child("SalvageSummary",true,false).text).contains("対象 1 個") and str(modal.find_child("SalvageSummary",true,false).text).contains("10"))
 modal.find_child("ConfirmSalvage",true,false).emit_signal("pressed")
 assert(app.profile.get_item(target.uid).is_empty() and app.profile.data.gold==10)
 assert(app.persistence_kind=="save" and app.persistence_ui.find_child("PersistenceRetry",true,false)!=null)
 app.profile.save_path=PATH_TEST;app.retry_persistence()
 assert(app.persistence_kind.is_empty())
 app.profile=Profile.new(true,bad_path)
 app.profile.load_failed=true;app.show_persistence_warning("load")
 assert(app.persistence_ui.find_child("PersistenceRetry",true,false)!=null)
 app.retry_persistence();assert(app.persistence_kind.is_empty() and not app.profile.load_failed)
 app.free()
 print("SALVAGE + SAVE: 600 items, exact payouts, equipped protection, socket return, round-trip, corrupt-load protection, UI and retry passed; elapsed %.2f ms" % elapsed_ms)
 DirAccess.remove_absolute(ProjectSettings.globalize_path(PATH_TEST))
 DirAccess.remove_absolute(ProjectSettings.globalize_path(bad_path))
 DirAccess.remove_absolute(ProjectSettings.globalize_path(directory_path))
 quit(0)
