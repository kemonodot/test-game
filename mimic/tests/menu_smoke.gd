extends SceneTree
func _initialize() -> void:
 call_deferred("run")
func run() -> void:
 var app = load("res://main.tscn").instantiate()
 root.add_child(app)
 app.profile = load("res://src/profile.gd").new(false)
 app.selected_uid=int(app.profile.data.inventory[0].uid)
 app.show_inventory()
 assert(app.state == "inventory")
 app.show_forge()
 assert(app.state == "forge")
 app.show_upgrades()
 assert(app.state == "upgrades")
 app.show_collection()
 assert(app.state == "collection")
 app.show_settings()
 assert(app.state == "settings")
 app.show_stages()
 assert(app.state == "stages")
 var tongue: Dictionary = app.profile.create_item("tongue")
 app.profile.data.inventory.append(tongue)
 assert(app.profile.equip(tongue.uid,"fang"))
 app.start_battle()
 assert(app.state == "battle")
 assert(app.battle.attack_range == 420.0)
 var touch=InputEventScreenTouch.new()
 touch.position=Vector2(100,100);touch.pressed=true
 app._gui_input(touch)
 var drag=InputEventScreenDrag.new()
 drag.position=Vector2(120,20)
 app._gui_input(drag)
 assert(app.battle.aim.y < -0.9 and app.battle.aim.x > 0)
 app.battle.hp = 0
 app._process(0.01)
 assert(app.state == "result")
 print("MENU SMOKE: equipment screen, build start and result screen passed")
 app.queue_free()
 quit(0)
