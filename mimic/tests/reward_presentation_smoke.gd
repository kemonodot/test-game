extends SceneTree
const Reward=preload("res://src/reward_presentation.gd")
const Profile=preload("res://src/profile.gd")
func _initialize()->void:call_deferred("run")
func run()->void:
 var fx=Reward.new()
 assert(is_equal_approx(fx.on_kill(),1.0))
 assert(fx.on_kill()==0.0) # simultaneous kills do not spam the mixer
 fx.update(0.05)
 assert(is_equal_approx(fx.on_kill(),1.18))
 fx.update(0.7)
 assert(is_equal_approx(fx.on_kill(),1.0))
 fx.money(Vector2(800,360),5,false)
 fx.money(Vector2(810,360),15,true)
 fx.money(Vector2(815,360),15,true)
 assert(fx.money_popups[0].value==5 and not fx.money_popups[0].bomb)
 assert(fx.money_popups[1].value==30 and fx.money_popups[1].bomb)
 assert(not fx.item(0,"普通",Vector2.ZERO,false,false))
 assert(not fx.item(0,"普通2",Vector2.ZERO,false,false))
 assert(fx.notifications[0].count==2)
 assert(fx.item(1,"レア",Vector2.ZERO,false,false))
 assert(fx.edge_rarity==1 and fx.edge_remaining>0.0)
 assert(fx.item(2,"エピック",Vector2.ZERO,false,false))
 assert(fx.edge_rarity==2)
 assert(fx.pickup_sparks.filter(func(x):return x.active).size()==2)
 assert(fx.pickup_sparks[0].rarity==1 and fx.pickup_sparks[1].rarity==2)
 assert(fx.item(3,"伝説",Vector2(700,350),false,false))
 assert(fx.notifications[3].reveal>0.0 and fx.notifications[3].rarity==3)
 assert(fx.slow_remaining>0.0 and fx.beam_rarity==3 and fx.beam_remaining>0.0)
 var slow_before:float=fx.slow_remaining
 assert(fx.item(4,"神話",Vector2(900,350),false,false))
 assert(fx.slow_remaining==slow_before and fx.beam_rarity==3)
 assert(fx.banners[0].name=="伝説" and fx.banners[1].name=="神話")
 fx.update(0.31)
 assert(fx.notifications[3].reveal==0.0 and fx.notifications[4].reveal==0.0)
 fx.update(0.3)
 assert(fx.pickup_sparks.filter(func(x):return x.active).is_empty())
 var reduced=Reward.new()
 assert(reduced.item(2,"エピック",Vector2.ZERO,true,false))
 assert(reduced.item(3,"伝説",Vector2.ZERO,true,false))
 assert(reduced.notifications[3].active and reduced.slow_remaining==0.0 and reduced.edge_remaining==0.0 and reduced.beam_remaining==0.0)
 assert(not reduced.banners[0].active)
 assert(reduced.pickup_sparks.filter(func(x):return x.active).is_empty())
 assert(not reduced.boss(Vector2.ZERO,"hero",true) and reduced.boss_result_wait==0.0)
 var overlap=Reward.new()
 assert(overlap.item(3,"先の伝説",Vector2.ZERO,false,false))
 var prior_slow:float=overlap.slow_remaining
 assert(not overlap.boss(Vector2(800,360),"hero",false))
 assert(overlap.slow_remaining==prior_slow and overlap.boss_result_wait>0.0)
 assert(overlap.pickup_sparks.filter(func(x):return x.active).is_empty())
 assert(overlap.banners[1].name=="BOSS 撃破" and not overlap.boss_full_reveal)
 var boss=Reward.new()
 assert(boss.boss(Vector2(800,360),"hero",false))
 assert(not boss.item(4,"本当の報酬",Vector2(800,360),false,true))
 assert(boss.boss_pending and not boss.notifications[4].active and boss.boss_item_rarity==4)
 boss.update(1.06)
 assert(not boss.boss_pending and boss.notifications[4].active and boss.pending_sound_rarity==4)
 assert(boss.banners[0].name=="本当の報酬" and boss.beam_remaining==0.0)
 # Boss loot, progression, and gold must already be saved while the reveal runs.
 var app=load("res://main.tscn").instantiate();root.add_child(app)
 app.profile=Profile.new(false);app.profile.data.settings={"sound":false}
 assert(app.kill_sound.stream.resource_path.ends_with("drop_002.wav"))
 assert(app.rarity_sound.stream.resource_path.ends_with("glass_003.wav"))
 assert(app.legendary_sounds[0].stream.resource_path.ends_with("confirmation_002.wav"))
 assert(app.boss_sound.stream.resource_path.ends_with("bong_001.wav"))
 app.show_credits()
 var licenses:Node=app.ui.find_child("ThirdPartyLicenses",true,false)
 assert(licenses!=null and licenses.text.contains("MIT License") and licenses.text.contains("Copyright (c) 2026 Patch") and licenses.text.contains("Creative Commons Zero"))
 assert(app.reward_atlases.size()==3)
 assert(app.reward_atlases["collect-burst"].meta.frames==17 and app.reward_atlases["holy-pillar"].meta.frames==43 and app.reward_atlases["implosion"].meta.frames==21)
 app.start_battle()
 app.reward_fx.item(3,"伝説",Vector2(800,360),false,false)
 var motion:=InputEventMouseMotion.new();motion.position=Vector2(640,100)
 app._gui_input(motion)
 assert(app.battle.aim.y < -0.99 and app.reward_fx.slow_remaining>0.0)
 # Start a fresh run so the boss receives a full reveal.
 app.start_battle();app.battle.spawn_enemy("hero",Vector2(760,360));app.battle.hit_enemy(0,1000000)
 app._process(0.01)
 assert(app.state=="battle" and app.battle.won and app.reward_given)
 assert(app.profile.data.unlocked_stage==1 and app.profile.data.inventory.size()>=2)
 var spark:Dictionary=app.battle.sparks.filter(func(x):return x.active)[0]
 var old_pos:Vector2=spark.pos
 app._process(0.05)
 assert(spark.pos!=old_pos) # victory debris continues during the visual slow-motion
 var saved=Profile.new(true)
 assert(saved.data.unlocked_stage==1 and saved.data.inventory.size()>=2)
 for i in 45:app._process(0.05)
 assert(app.state=="result")
 app.free()
 print("REWARD FX: pitch, bundling, truthful reveal, overlap, reduced mode and immediate persistence passed")
 quit(0)
